// A static page on Cloudflare Workers. `wrangler deploy` (run by .github/workflows/deploy.yml once
// the checks pass) uploads this folder as it is, minus .assetsignore. No build step. The deploy
// also attaches the qr.honestrobin.com custom domain. No workers.dev address and no preview links:
// the tool has one address. The one piece of server code, worker/index.js, answers /count only:
// it writes the page's counts to Cloudflare's own store (Workers Analytics Engine, the dataset
// qr_counts, kept three months), about 60 a minute from one address. Cloudflare keeps no log of
// its requests for us (observability off). Run locally, for the checks, wrangler gives it a store
// that keeps nothing and has no way to reach the real one.
{
  "name": "honestrobin-qr",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "qr.honestrobin.com", "custom_domain": true }],
  "main": "worker/index.js",
  "assets": { "directory": ".", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/count"] },
  "analytics_engine_datasets": [{ "binding": "COUNTS", "dataset": "qr_counts" }],
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1101", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": false }
}
